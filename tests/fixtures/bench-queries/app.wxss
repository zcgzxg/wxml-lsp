/* 全局样式（bench fixture）。
   .card 在这里声明一次，页面 index.wxss 也会声明，
   用于 query/class/definition 断言“页面样式优先”。 */
@import "styles/theme.wxss";

page {
  background: #f6f7fb;
  color: #1f2329;
  font-size: 28rpx;
}

.card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.toolbar-title {
  font-size: 34rpx;
  font-weight: 600;
}

.toolbar-action {
  color: #57606a;
  font-size: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.card-body {
  padding: 16rpx 0;
}

.card-footer {
  border-top: 1rpx solid #e5e6eb;
  padding-top: 16rpx;
}

.card-meta {
  color: #86909c;
  font-size: 22rpx;
}

.list-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.list-label {
  color: #1f2329;
}

.list-value {
  color: #0e7490;
  font-variant-numeric: tabular-nums;
}

.text-muted {
  color: #86909c;
}

.text-strong {
  color: #1f2329;
  font-weight: 600;
}

.flex {
  display: flex;
}

.flex-between {
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: #e5e6eb;
  margin: 16rpx 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0e7490;
}

.is-highlighted {
  background: #e6f4f1;
}
