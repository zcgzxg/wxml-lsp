    {
      "id": "unsaved-overlay",
      "kind": "runtime",
      "acs": [
        "AC-004"
      ],
      "scenario": "在 Zed 中打开 index.wxml 与 index.ts，修改 data.user.name 的类型或 JSDoc 但不保存，再到模板悬停 user.name。服务必须仅凭内存覆盖层重新分析并返回新的类型与说明，不要求保存文件或重新加载模板，也不得回退到磁盘旧内容。",
      "steps": [
        {
          "action": "didOpen index.wxml and index.ts",
          "expect": "initial hover returns the declared type and documentation"
        },
        {
          "action": "didChange index.ts without saving the JSDoc of data.user.name",
          "expect": "hover user.name returns the updated documentation without saving"
        },
        {
          "action": "didChange the referenced type without saving",
          "expect": "hover follows the new type without saving or reloading the template"
        }
      ]
    },
    {
      "id": "stale-request",
      "kind": "runtime",
      "acs": [
        "AC-009"
      ],
      "scenario": "触发一次 hover 后立刻继续编辑，使旧请求在依赖新快照后才返回；随后模拟类型后端超时并退出。旧结果和旧 ACK 不得发布，能力状态应显示不可用；后端以新的 BackendEpoch 重启并重放快照后，查询恢复且版本号递增。",
      "steps": [
        {
          "action": "issue hover for snapshot 1 and delay the response",
          "expect": "the request stays pending"
        },
        {
          "action": "didChange the template to snapshot 2",
          "expect": "snapshot 2 is scheduled and published"
        },
        {
          "action": "deliver the delayed snapshot 1 result",
          "expect": "the stale result is dropped and never published"
        },
        {
          "action": "terminate the backend",
          "expect": "capabilities report unavailable instead of a clean result"
        },
        {
          "action": "restart the backend with a new epoch and replay the snapshot",
          "expect": "hover recovers and the reported epoch is incremented"
        }
      ]
    },
    {
      "id": "zed-multi-doc",
      "kind": "runtime",
      "acs": [
        "AC-010"
      ],
      "scenario": "在 Zed 中同时打开 index.wxml、index.ts 与 types.ts，并保持原有 JS/TS 主服务开启。未保存事件必须进入 WXML 服务的正确实例，types.ts 的类型与 JSDoc 修改立即反映到模板；主服务继续工作，且不重复发布无关脚本诊断。",
      "steps": [
        {
          "action": "open index.wxml, index.ts and types.ts in Zed with the main TypeScript service running",
          "expect": "the WXML service receives all three documents in the same instance"
        },
        {
          "action": "didChange types.ts without saving",
          "expect": "the template diagnostic and hover update without saving"
        },
        {
          "action": "query the main TypeScript service",
          "expect": "the main service still works and no duplicate script diagnostics are published"
        }
      ]
    }
