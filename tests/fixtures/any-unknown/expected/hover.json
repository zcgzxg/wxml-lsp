{
  "queries": [
    {
      "file": "pages/index/index.wxml",
      "marker": "{{ label }}",
      "target": "label",
      "expect": { "type": "string", "typeKind": "string", "documentation": "有明确类型的字段" }
    },
    {
      "file": "pages/index/index.wxml",
      "marker": "{{ payload }}",
      "target": "payload",
      "expect": {
        "type": "any",
        "typeKind": "any",
        "documentation": "来自未类型化 SDK 的任意值",
        "quality": "any"
      }
    },
    {
      "file": "pages/index/index.wxml",
      "marker": "{{ payload.anything }}",
      "target": "payload.anything",
      "expect": { "type": "any", "typeKind": "any", "documentation": "", "quality": "any" }
    },
    {
      "file": "pages/index/index.wxml",
      "marker": "{{ external }}",
      "target": "external",
      "expect": {
        "type": "unknown",
        "typeKind": "unknown",
        "documentation": "尚未确认形状的外部数据",
        "quality": "unknown"
      }
    }
  ]
}
