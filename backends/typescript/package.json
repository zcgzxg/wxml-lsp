{
  "name": "@wxml-lsp/type-bridge-probe",
  "version": "0.1.0",
  "private": true,
  "description": "P5/P6 Node type backend for the WXML language service (C1.1 JSON-RPC over stdio).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "matrix": "node src/cli.ts",
    "matrix:json": "node src/cli.ts --json",
    "perf:json": "node src/cli.ts --perf --json",
    "evidence": "node scripts/emit-evidence.ts",
    "inspect": "node scripts/inspect.ts"
  },
  "main": "dist/server.js",
  "bin": {
    "wxml-type-backend": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "miniprogram-api-typings": "5.3.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
